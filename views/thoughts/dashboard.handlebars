<div class="content dashboard">
  {{> message}}
    <div class="dashboard-line">
      <h1>Dashboard</h1>
      <a href="/thoughts/add">Criar Pensamento</a>
    </div>
      <h3>Seus Pensamentos</h3>
    {{#if emptyThoughts}}
    <div class="empty-alert">
      <p>Não há pensamentos cadastrados, <a href="/thoughts/add">comece por aqui!</a></p>
    </div>
    {{else}}
    <ul>
      {{#each thoughts}}
      <li>
        <span class="label">{{this.title}}</span>
        <span class="actions">
          <a href="/thoughts/edit/{{this.id}}" class="edit">Editar</a>
          <form action="/thoughts/delete" method="POST">
          <input type="hidden" name="id" value="{{this.id}}">
          <input type="submit" value="Excluir">
          </form>
          </span>
        </li>
      {{/each}}
    </ul>
    {{/if}}
</div>