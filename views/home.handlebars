<div class="content home">
  {{> message}}
      {{#if search}}
            <h1>Você esta buscando por: <span>{{search}}</span> </h1>
            <p>Resultados encontrados: <span>{{qtdSearch}}</span> pensamentos</p>
      {{else}}
            <h1>Todos os Pensamentos</h1>
      {{/if}}
      <form action="/" method="GET">
        <input type="text" name="search" placeholder="Está buscando por algo?">
        <input type="submit" value="Buscar">
      </form>
      <div class="order-container">
        <span>Ordernar por:</span>
        <form action="/" method="GET">
          <input type="hidden" name="search" value="{{this.search}}">
          <input type="hidden" name="order" value="new">
          <button type="submit"><i class="bi bi-arrow-up"></i></button>
        </form>
        <form action="/" method="GET">
          <input type="hidden" name="search" value="{{this.search}}">
          <input type="hidden" name="order" value="old">
          <button type="submit"><i class="bi bi-arrow-down"></i></button>
        </form>
        <a href="/">Limpar</a>
      </div>
    {{#if emptyThoughts}}
    <div class="empty-alert">
      <p>Não há pensamentos cadastrados, publique <a href="/thoughts/add">clicando aqui!</a></p>
    </div>
    {{else}}
      {{#each thoughts}}
      <figure>
        <blockquote>
          "{{this.title}}"
        </blockquote>
        <figcaption>por <span>{{this.User.name}}</span></figcaption>
      </figure>
      {{/each}}
    {{/if}}
</div>