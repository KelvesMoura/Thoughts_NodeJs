<div class="content create">
  <a href="/thoughts/dashboard">Voltar</a>
  <form action="/thoughts/add" method="POST">
    <div class="form-control">
      <h1>Criando um Pensamento</h1>
      <label for="title">Pensamento:</label>
      <input
        type="text"
        name="title"
        placeholder="Digite o seu pensamento..."
        required
      />
      <input type="submit" value="Criar Pensamento" />
    </div>
  </form>
</div>